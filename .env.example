# Copy to .env and fill in. Loaded by crowspeak-cli via python-dotenv (uv sync --group cli).

# Which LLM provider to use: "azure" (default) or "local".
LLM_PROVIDER=azure

# --- azure: Azure AI Foundry (costs real money) ---
# Endpoint forms: https://<resource>.openai.azure.com/ or https://<resource>.services.ai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- local: any OpenAI-compatible server, e.g. Ollama ---
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=gemma4:e4b

# --- per-job overrides (used by providers_from_env) ---
# A job named X reads LLM_X_PROVIDER, _MODEL, _ENDPOINT, _API_KEY and _API_VERSION. Each one
# that is set replaces just that field; the rest come from the provider variables above.
# Built-in jobs: NPC, CORRECTIONS. Anything set to azure is live Azure spend.
# Example: local NPC with corrections on a different Azure resource:
# LLM_PROVIDER=local
# LLM_CORRECTIONS_PROVIDER=azure
# LLM_CORRECTIONS_ENDPOINT=https://<other-resource>.services.ai.azure.com/
# LLM_CORRECTIONS_API_KEY=
# LLM_CORRECTIONS_MODEL=
# LLM_CORRECTIONS_API_VERSION=
