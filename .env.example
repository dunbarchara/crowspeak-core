# Copy to .env and fill in. Loaded by crowspeak-cli via python-dotenv.

# Which LLM provider to use: "azure" (default) or "local".
LLM_PROVIDER=azure

# --- azure: Azure AI Foundry (costs real money) ---
# Endpoint forms: https://<resource>.openai.azure.com/ or https://<resource>.services.ai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- local: any OpenAI-compatible server, e.g. Ollama ---
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=gemma4:e4b

# --- per-job overrides (used by providers_from_env) ---
# A job named X reads LLM_X_PROVIDER and LLM_X_MODEL; unset means "use the default above".
# Built-in jobs: NPC, CORRECTIONS. Endpoint and key stay shared per provider.
# Example: local NPC with corrections on Azure (this is live Azure spend):
# LLM_PROVIDER=local
# LLM_CORRECTIONS_PROVIDER=azure
# LLM_CORRECTIONS_MODEL=

